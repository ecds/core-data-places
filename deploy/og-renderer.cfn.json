{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Open Geographies renderer (core-data-places) on Fargate with ECS Exec, behind the shared ALB",
  "Parameters": {
    "Name": {
      "Type": "String",
      "Description": "Service name, task family and log stream prefix",
      "AllowedPattern": "^og-renderer(-(dev|staging))?$",
      "Default": "og-renderer"
    },
    "ClusterName": {
      "Type": "String",
      "Default": "FairData"
    },
    "DockerImage": {
      "Type": "String",
      "Description": "ECR repository URI for the renderer image, without a tag"
    },
    "DockerImageVersion": {
      "Type": "String",
      "Default": "latest"
    },
    "TaskCpu": {
      "Type": "String",
      "Default": "512"
    },
    "TaskMemory": {
      "Type": "String",
      "Default": "1024"
    },
    "ServiceDesiredCount": {
      "Type": "Number",
      "Default": 2
    },
    "ContainerPort": {
      "Type": "Number",
      "Default": 8080
    },
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "ListenerArn": {
      "Type": "String",
      "Description": "The shared ALB's HTTPS listener"
    },
    "ListenerRulePriority": {
      "Type": "Number",
      "Description": "Must not clash with the listener's existing rules"
    },
    "HostHeader": {
      "Type": "String",
      "Default": "*.opengeographies.org"
    },
    "SecurityGroups": {
      "Type": "List<AWS::EC2::SecurityGroup::Id>"
    },
    "Subnets": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "LogRetentionDays": {
      "Type": "Number",
      "Default": 30
    },
    "BaseDomain": {
      "Type": "String",
      "Default": "opengeographies.org"
    },
    "ConsoleUrl": {
      "Type": "String",
      "Description": "The FairData host, as the renderer reaches it",
      "Default": "https://coredata.ecds.io"
    },
    "ElasticsearchUrl": {
      "Type": "String",
      "Default": "https://search.ecds.io"
    },
    "ElasticsearchApiKeySecretArn": {
      "Type": "String",
      "Description": "Full ARN of the renderer's read-only key covering open_geographies_v1*"
    },
    "TileServer": {
      "Type": "String",
      "Default": "https://pmtiles.ecds.io"
    }
  },
  "Resources": {
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ecs-tasks.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Policies": [
          {
            "PolicyName": "read-secrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": {
                    "Ref": "ElasticsearchApiKeySecretArn"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/ecs/${ClusterName}/${Name}"
        },
        "RetentionInDays": {
          "Ref": "LogRetentionDays"
        }
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "ecs-tasks.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ecs-exec",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssmmessages:CreateControlChannel",
                    "ssmmessages:CreateDataChannel",
                    "ssmmessages:OpenControlChannel",
                    "ssmmessages:OpenDataChannel"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": {
          "Ref": "Name"
        },
        "VpcId": {
          "Ref": "VpcId"
        },
        "TargetType": "ip",
        "Protocol": "HTTP",
        "Port": {
          "Ref": "ContainerPort"
        },
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 30,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "ListenerRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "ListenerArn"
        },
        "Priority": {
          "Ref": "ListenerRulePriority"
        },
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                {
                  "Ref": "HostHeader"
                }
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Ref": "Name"
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "NetworkMode": "awsvpc",
        "Cpu": {
          "Ref": "TaskCpu"
        },
        "Memory": {
          "Ref": "TaskMemory"
        },
        "ContainerDefinitions": [
          {
            "Name": "renderer",
            "Image": {
              "Fn::Sub": "${DockerImage}:${DockerImageVersion}"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": {
                  "Ref": "ContainerPort"
                },
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "NODE_ENV",
                "Value": "production"
              },
              {
                "Name": "PORT",
                "Value": {
                  "Fn::Sub": "${ContainerPort}"
                }
              },
              {
                "Name": "OG_BASE_DOMAIN",
                "Value": {
                  "Ref": "BaseDomain"
                }
              },
              {
                "Name": "OG_CONSOLE_URL",
                "Value": {
                  "Ref": "ConsoleUrl"
                }
              },
              {
                "Name": "OG_ELASTICSEARCH_URL",
                "Value": {
                  "Ref": "ElasticsearchUrl"
                }
              },
              {
                "Name": "OG_TILE_SERVER",
                "Value": {
                  "Ref": "TileServer"
                }
              },
              {
                "Name": "OG_ATLAS_CACHE_TTL_MS",
                "Value": "90000"
              },
              {
                "Name": "OG_ATLAS_ERROR_TTL_MS",
                "Value": "5000"
              },
              {
                "Name": "OG_ATLAS_FETCH_TIMEOUT_MS",
                "Value": "5000"
              },
              {
                "Name": "OG_WORDPRESS_TIMEOUT_MS",
                "Value": "5000"
              }
            ],
            "Secrets": [
              {
                "Name": "OG_ELASTICSEARCH_API_KEY",
                "ValueFrom": {
                  "Ref": "ElasticsearchApiKeySecretArn"
                }
              }
            ],
            "LinuxParameters": {
              "InitProcessEnabled": true
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "LogGroup"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": {
                  "Ref": "Name"
                }
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                {
                  "Fn::Sub": "node -e \"fetch('http://127.0.0.1:${ContainerPort}/health').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))\""
                }
              ],
              "Interval": 30,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 30
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "DependsOn": "ListenerRule",
      "Properties": {
        "ServiceName": {
          "Ref": "Name"
        },
        "Cluster": {
          "Ref": "ClusterName"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "TaskDefinition": {
          "Ref": "TaskDefinition"
        },
        "DesiredCount": {
          "Ref": "ServiceDesiredCount"
        },
        "EnableExecuteCommand": true,
        "EnableECSManagedTags": true,
        "PropagateTags": "SERVICE",
        "HealthCheckGracePeriodSeconds": 60,
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "SecurityGroups": {
              "Ref": "SecurityGroups"
            },
            "Subnets": {
              "Ref": "Subnets"
            }
          }
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            },
            "ContainerName": "renderer",
            "ContainerPort": {
              "Ref": "ContainerPort"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "OpenGeographies"
          }
        ]
      }
    }
  },
  "Outputs": {
    "TargetGroupArn": {
      "Value": {
        "Ref": "TargetGroup"
      }
    },
    "ServiceName": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name"
        ]
      }
    }
  }
}
