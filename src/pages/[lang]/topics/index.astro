---
import NotFound from '@apps/pages/NotFound.astro';
import TopicTree from '@apps/topics/TopicTree.astro';
import { getAtlasConfig } from '@atlas/server';
import { getTranslations } from '@backend/i18n';
import Container from '@components/Container.astro';
import Layout from '@layouts/Layout.astro';
import { buildTopicTree, fetchTopics, getTopicsConfig } from '@utils/topics';
import { setCacheControl } from '@utils/url';

/**
 * Topics: the atlas's categories as a tree (the curator's groups, then the
 * rest), each with its count, linking to its page. A 404 when the atlas
 * hasn't turned topics on.
 */
const lang = Astro.currentLocale as string;
const { t } = await getTranslations(lang);
const config = getAtlasConfig();
const topicsConfig = getTopicsConfig(config);

let tree = [];
let ungrouped = [];
let failed = false;

if (topicsConfig.enabled) {
  try {
    ({ tree, ungrouped } = buildTopicTree(topicsConfig.groups, await fetchTopics(config)));
  } catch (error) {
    failed = true;
  }
} else {
  Astro.response.status = 404;
}

const title = topicsConfig.title || t('topics');
const placesLabel = (count: number) => (count === 1 ? t('topicCountOne') : t('topicCount', { count }));
setCacheControl(Astro.response.headers);
---
<Layout description={topicsConfig.intro} footer title={title}>
  { topicsConfig.enabled ? (
    <>
      <div class='bg-primary w-full pb-8 pt-10'>
        <Container>
          <h1 class='text-5xl font-header'>{ title }</h1>
          { topicsConfig.intro && <p class='pt-4 max-w-3xl text-lg'>{ topicsConfig.intro }</p> }
        </Container>
      </div>
      <Container className='py-10'>
        { failed && <p>{ t('topicsUnavailable') }</p> }
        { !failed && tree.length === 0 && ungrouped.length === 0 && <p>{ t('noTopics') }</p> }
        <TopicTree lang={lang} nodes={tree} placesLabel={placesLabel} />
        { ungrouped.length > 0 && (
          <section class={tree.length ? 'pt-10' : ''}>
            { tree.length > 0 && <h2 class='text-2xl font-header pb-2'>{ t('otherTopics') }</h2> }
            <ul class='flex flex-wrap gap-2'>
              { ungrouped.map((topic) => (
                <li>
                  <a class='inline-flex items-baseline gap-1.5 rounded-full border border-neutral-300 px-3 py-1 hover:bg-neutral-100 focus-visible:ring-2' href={`/${lang}/topics/${encodeURIComponent(topic.slug)}`}>
                    <span>{ topic.name }</span>
                    <span class='text-sm text-neutral-600'>{ placesLabel(topic.count) }</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </Container>
    </>
  ) : <NotFound /> }
</Layout>
