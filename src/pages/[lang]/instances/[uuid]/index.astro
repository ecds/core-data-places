---
import Instance from '@apps/detailPages/Instance.astro';
import Layout from '@layouts/Layout.astro';
import { ModelNames } from '@services/coreData/factory';
import { getDetailPagePaths } from '@utils/detailPages';

const { lang, uuid } = Astro.params;

export const getStaticPaths = async () => await getDetailPagePaths(ModelNames.instances);

---

<Layout
  footer
>
  <Instance
    lang={lang}
    uuid={uuid}
    server:defer
  >
    { /* Holds the page's height while the record loads, so the footer doesn't jump. */ }
    <div slot='fallback' class='min-h-screen' aria-busy='true'></div>
  </Instance>
</Layout>
