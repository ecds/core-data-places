---
import RecordDetail from '@apps/detailPages/RecordDetail.astro';
import PageStoreProvider from '@components/PageStoreProvider';
import { getAtlasConfig } from '@atlas/server';
import { getExclusions } from '@utils/exclusions';
import PlacesService from '@services/coreData/places';
import { CoreData as CoreDataUtils } from '@performant-software/core-data/ssr';
import { bounds } from '@utils/map';

const { lang, uuid } = Astro.props;

const { place } = await PlacesService.getOne(uuid);
const excludes = getExclusions(getAtlasConfig(), 'places');

// A place without coordinates (an uploaded row with no location) gets no
// map rather than an empty one.
const collection = excludes.includes('place_geometry')
  ? null
  : CoreDataUtils.toFeatureCollection([place]);
const geometry = bounds(collection) ? collection : null;
---

<RecordDetail
  excludes={excludes}
  geometry={geometry}
  lang={lang}
  model='places'
  name={place.name}
  record={place}
/>

<PageStoreProvider
  title={place.name}
  client:load
/>