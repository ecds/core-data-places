---
import config from '@config';

/**
 * Renders longform content fetched from a WordPress site's REST API.
 *
 * Enabled per-model via config:
 *
 *   "detail_pages": {
 *     "models": {
 *       "places": {
 *         "wordpress": {
 *           "host": "https://wp.example.org",
 *           "field": "<user-defined field UUID containing the post ID or slug>",
 *           "resource": "posts"
 *         }
 *       }
 *     }
 *   }
 */
interface Props {
  model: string;
  record: any;
}

const { model, record } = Astro.props;

const wordpress = config.detail_pages?.models?.[model]?.wordpress;
const value = wordpress && record.user_defined?.[wordpress.field]?.value;

let content = null;

if (wordpress && value) {
  const host = wordpress.host.replace(/\/$/, '');
  const resource = wordpress.resource || 'posts';

  // Numeric values are treated as WordPress IDs, anything else as a slug.
  const url = /^\d+$/.test(`${value}`.trim())
    ? `${host}/wp-json/wp/v2/${resource}/${`${value}`.trim()}`
    : `${host}/wp-json/wp/v2/${resource}/?slug=${encodeURIComponent(value)}`;

  try {
    const response = await fetch(url);

    if (response.ok) {
      const data = await response.json();
      const post = Array.isArray(data) ? data[0] : data;
      content = post?.content?.rendered || null;
    }
  } catch {
    // An unreachable WordPress host should not take down the detail page.
  }
}
---

{ content && (
  <div class='py-6'>
    <div
      class='wp-content max-w-none'
      set:html={content}
    />
  </div>
)}

<style is:global>
  .wp-content {
    line-height: 1.7;
  }

  .wp-content h1,
  .wp-content h2,
  .wp-content h3,
  .wp-content h4 {
    font-weight: 600;
    margin: 1.25em 0 0.5em;
  }

  .wp-content h1 { font-size: 1.5rem; }
  .wp-content h2 { font-size: 1.3rem; }
  .wp-content h3 { font-size: 1.15rem; }

  .wp-content p {
    margin: 0.75em 0;
  }

  .wp-content a {
    text-decoration: underline;
  }

  .wp-content ul,
  .wp-content ol {
    margin: 0.75em 0;
    padding-left: 1.5em;
  }

  .wp-content ul { list-style: disc; }
  .wp-content ol { list-style: decimal; }

  .wp-content blockquote {
    border-left: 3px solid #e5e5e5;
    margin: 1em 0;
    padding-left: 1em;
  }

  .wp-content figure {
    margin: 1.25em 0;
  }

  .wp-content figure img {
    height: auto;
    max-width: 100%;
  }

  .wp-content figcaption {
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
