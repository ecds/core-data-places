---
import RecordDetail from '@apps/detailPages/RecordDetail.astro';
import PageStoreProvider from '@components/PageStoreProvider';
import { getAtlasConfig } from '@atlas/server';
import { getExclusions } from '@utils/exclusions';
import InstancesService from '@services/coreData/instances';

const { lang, uuid } = Astro.props;

const { instance } = await InstancesService.getOne(uuid);
const excludes = getExclusions(getAtlasConfig(), 'instances');

---

<RecordDetail
  excludes={excludes}
  lang={lang}
  model='instances'
  name={instance.name}
  record={instance}
/>

<PageStoreProvider
  title={instance.name}
  client:load
/>