---
import PlaceMap from '@apps/detailPages/PlaceMap';
import { getAtlasConfig } from '@atlas/server';
import Container from '@components/Container.astro';
import ServiceFactory from '@services/coreData/factory';
import { getCoverImage } from '@utils/detailPages';
import { bounds } from '@utils/map';
import { getPhotoField, getPhotoUrl } from '@utils/photos';

interface Props {
  geometry?: any;
  lang: string;
  model: string;
  name: string;
  record: any;
}

const { geometry: data, lang, record, model, name } = Astro.props;

// A map only when there's something to show on it: a record without
// coordinates gets its cover image (if any), not an empty map.
const geometry = bounds(data) ? data : null;

const service = ServiceFactory.getService(model);
const { mediaContents } = await service.getRelatedMediaContents(record.uuid);

// A media item's image, else the place's own photo field (an upload's Photo
// column).
const coverUrl = getCoverImage(mediaContents) || getPhotoUrl(record, getPhotoField(getAtlasConfig(), model), (getAtlasConfig() as any)?.core_data?.url);
---
{(geometry || coverUrl) && (
  <div class='w-full pb-6 relative h-[300px]'>
    <div class='bg-primary h-[80px] w-full' />
    <div class='absolute gap-6 w-full top-0'>
      <Container className='h-[300px] flex gap-6'>
        {coverUrl && (
          <img
            alt={name}
            class={`${geometry ? 'w-[40%]' : 'w-full'} h-full object-cover`}
            src={coverUrl}
          />
        )}
        {geometry && (
          <div class={coverUrl ? 'w-[60%]' : 'w-full'}>
            <PlaceMap
              client:only='react'
              geometry={geometry}
              lang={lang}
            />
          </div>
        )}
      </Container>
    </div>
  </div>
)}

