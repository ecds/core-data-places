---
import { findSlugs, recordPath } from '@utils/recordAddress';
import ServiceFactory from '@services/coreData/factory';
import { getTranslations } from '@backend/i18n';
import Relations from '@apps/detailPages/Relations.astro';
import { getAtlasConfig } from '@atlas/server';
import { hasDetailPage } from '@utils/detailPagePaths';
import { groupRelationships } from '@utils/detailPages';
import { getNameView } from '@utils/people';

interface Props {
  excludes: string[];
  model: string;
  uuid: string;
}

const { excludes, model, uuid } = Astro.props;

const lang = Astro.currentLocale;
const service = ServiceFactory.getService(model);
const { people } = await service.getRelatedPeople(uuid);
// Link each record by its slug where it has its own (see @utils/recordAddress).
const slugs = await findSlugs(getAtlasConfig(), 'people', (people || []).map((record: any) => record.uuid));
const relationships = groupRelationships(people, excludes);
const { t } = await getTranslations(lang);
---
{Object.keys(relationships).map((uuid) => (
  <Relations
    data={relationships[uuid]}
    icon='person'
    label={t(uuid)}
    resolveDetailUrl={(person) => recordPath(lang, 'people', { uuid: person.uuid, slug: slugs[person.uuid] })}
    resolveName={person => getNameView(person)}
    showLinks={hasDetailPage('people', getAtlasConfig())}
    uuid={uuid}
  />
))}
