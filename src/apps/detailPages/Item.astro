---
import RecordDetail from '@apps/detailPages/RecordDetail.astro';
import PageStoreProvider from '@components/PageStoreProvider';
import { getAtlasConfig } from '@atlas/server';
import { getExclusions } from '@utils/exclusions';
import ItemsService from '@services/coreData/items';

const { lang, uuid } = Astro.props;

const { item } = await ItemsService.getOne(uuid);
const excludes = getExclusions(getAtlasConfig(), 'items');

---

<RecordDetail
  excludes={excludes}
  lang={lang}
  model='items'
  name={item.name}
  record={item}
/>

<PageStoreProvider
  title={item.name}
  client:load
/>