---
import { getAtlasConfig } from '@atlas/server';
import { fetchWordPressDocument } from '@backend/wordpress';
import Container from '@components/Container.astro';
import WordPressBody from '@components/WordPressBody.astro';
import { setCacheControl } from '@utils/url';

/**
 * A longform page fetched by slug from the atlas's WordPress
 * (`config.wordpress.host`): the fallback for /pages/:slug when the console
 * has no page by that address, and the WordPress body under a home page.
 * Renders nothing when no page matches.
 */
const { slug } = Astro.props;

const wordpress = getAtlasConfig().wordpress;

const page = await fetchWordPressDocument({
  host: wordpress?.host,
  resource: 'pages',
  value: slug
});

setCacheControl(Astro.response.headers);
---

{ page?.content && (
  <Container
    className='py-12 w-full'
  >
    <WordPressBody content={page.content} />
  </Container>
)}
