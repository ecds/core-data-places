---
import { getAtlasBranding, getAtlasConfig, getAtlasContent } from '@atlas/server';
import Page from '@apps/pages/Page.astro';
import Sections from '@apps/pages/sections/Sections.astro';
import PageStoreProvider from '@components/PageStoreProvider';
import { setCacheControl } from '@utils/url';

/**
 * The atlas landing page: the console-owned home page (its sections; the
 * console gives every atlas one, starting with a banner and search box). An
 * atlas with a WordPress home page (`config.home.wordpress_slug`) gets that
 * body below the sections, deferred since it's a network fetch. With no atlas
 * resolved (the fallback bundle) the site title alone renders.
 */
const branding = getAtlasBranding();
const home = getAtlasContent(Astro.currentLocale).home ?? { sections: [{ type: 'hero' as const }] };
const wordpressSlug = getAtlasConfig().home?.wordpress_slug;

setCacheControl(Astro.response.headers);
---

<Sections
  home
  page={home}
/>

{ wordpressSlug && (
  <Page
    slug={wordpressSlug}
    server:defer
  />
)}

<PageStoreProvider
  title={branding.title}
  client:load
/>
