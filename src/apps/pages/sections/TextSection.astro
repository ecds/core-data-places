---
import Container from '@components/Container.astro';
import { markdownToHtml } from '@utils/html';

/**
 * A heading (optional) and Markdown text, at a readable line length.
 */
const { assetBase, images, section } = Astro.props;

const html = markdownToHtml(section.body, { assetBase, images });
---

<section
  class='w-full py-12'
>
  <Container>
    <div
      class='max-w-3xl mx-auto'
    >
      { section.title && (
        <h2
          class='mb-6 text-content'
        >
          { section.title }
        </h2>
      )}
      { html && (
        <div
          class='prose prose-lg max-w-none text-content'
          set:html={html}
        />
      )}
    </div>
  </Container>
</section>
