---
/**
 * The footer's bottom row: the terms/privacy/accessibility links the atlas
 * has set (unset ones are left out rather than pointing at "#"), and the
 * copyright line.
 */
const { copyright, links } = Astro.props;
---

<div
  class='flex border-t border-neutral-500 py-4 w-full font-light z-10'
>
  <div
    class='flex flex-col lg:flex-row items-center lg:justify-between gap-y-4 w-full text-sm px-8 lg:px-0'
  >
    { links.length > 0 && (
      <div
        class='flex flex-col lg:flex-row items-center gap-y-4 lg:divide-x-1'
      >
        { links.map((link) => (
          <a
            class='lg:px-6 lg:first:ps-0'
            href={link.href}
          >
            { link.label }
          </a>
        ))}
      </div>
    )}
    <div
      class='text-center'
    >
      { copyright }
    </div>
  </div>
</div>
