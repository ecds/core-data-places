---
import { getAssetBase, getAtlasBranding, getAtlasContent, getAtlasDefaultLocale, getAtlasImages, getAtlasLocales, isAtlasPreview, localizeHref } from '@atlas/server';
import NotificationPanel from '@components/NotificationPanel';
import Title from '@components/Title';
import { getLanguageFromUrl } from '@i18n/utils';
import Footer from '@layouts/Footer.astro';
import Header from '@layouts/Header.astro';
import HeaderContainer from '@layouts/HeaderContainer';
import { getTranslations } from '@backend/i18n';
import { fontFamily, fontsHref } from '@utils/fonts';
import { findImage, imageUrlAtHeight, imageUrlAtWidth } from '@utils/images';
import { useBlackText } from '@utils/layout';
import { publicOrigin } from '@utils/sitemap';
import { setCacheControl } from '@utils/url';
import { STATIC_BUILD } from 'astro:env/client';
import clsx from 'clsx';
import _ from 'underscore';

import '@performant-software/core-data/style.css';
import '@performant-software/geospatial/style.css';
import '@styles/index.css';
import 'swiper/css';
import 'swiper/css/pagination';

setCacheControl(Astro.response.headers);

const branding = getAtlasBranding();
const { header, footer } = branding;

const { font_header: fontHeader, font_body: fontBody } = branding;

const heroHeaderSize = branding.header_size || '52px';
const pageHeaderSize = branding.page_header_size || '48px';
const headerFontWeight = branding.header_font_weight || '400';
const bannerHeaderVariant = branding.header_capitalization === 'small-caps' ? 'small-caps' : 'normal';
const bannerHeaderTransform = branding.header_capitalization === 'uppercase' ? 'uppercase' : 'none';

//dark and light mode default text color
const content = branding.content_color || 'var(--color-black)';
const contentInverse = branding.content_inverse || 'var(--color-white)';
const contentAlternate = branding.content_alternate || 'var(--color-neutral-dark)';
const contentInverseAlternate = branding.content_inverse_alternate || 'var(--color-neutral-light)';

const colorPrimary = branding.primary_color;
const colorSecondary = branding.secondary_color;
const colorTertiary = branding.tertiary_color || 'var(--color-black)';

//these are for use in layout components like header and footer
const primaryContent = useBlackText(colorPrimary) ? content : contentInverse;
const secondaryContent = !colorSecondary || useBlackText(colorSecondary) ? content : contentInverse;
const tertiaryContent = !colorTertiary || useBlackText(colorTertiary) ? content : contentInverse;

const colorLayout = branding.background_color || 'var(--color-white)';
const layoutContent = !branding.background_color || useBlackText(branding.background_color) ? content : contentInverse;
const layoutContentAlternate = !branding.background_color || useBlackText(branding.background_color) ? contentAlternate : contentInverseAlternate;

const colorLayoutAlternate = branding.background_alternate || 'var(--color-neutral-light)';
const layoutAlternateContent = !branding.background_alternate || useBlackText(branding.background_alternate) ? content : contentInverse;
const layoutAlternateContentAlternate = !branding.background_alternate || useBlackText(branding.background_alternate) ? contentAlternate : contentInverseAlternate; //this naming scheme could be better....

const lang = getLanguageFromUrl(Astro.url.pathname);

const {
  description,
  footer: includeFooter,
  fullscreen,
  image,
  title,
  titleKey,
  transparent
} = Astro.props;

// Uploaded images are console paths; the browser needs them absolute, and
// a copy of the size it's shown at: the logo is 48 px tall in both headers,
// a favicon at most 64 px.
const imageOptions = { assetBase: getAssetBase(), images: getAtlasImages() };
const logo = imageUrlAtHeight(branding.logo || header?.logo, 48, imageOptions);
const favicon = imageUrlAtWidth(branding.favicon, 64, imageOptions) || '/favicon.svg';

// The page's own title (a console page) ahead of the site title, a
// description for search engines and link previews, and a share image
// (the page's banner image, else the one set in branding).
const documentTitle = title && title !== branding.title ? `${title} · ${branding.title}` : branding.title;
// What the Title island would show first (a translated key such as
// "Explore"), rendered by the server so the head is complete without it.
const { t: translate } = await getTranslations(lang);
const serverTitle = (titleKey && translate(titleKey)) || documentTitle;
// With neither, the home page banner's subtitle (the wizard's description
// of the atlas) stands in, so no page goes without one.
const homeSubtitle = getAtlasContent(Astro.currentLocale).home?.sections?.find((section) => section.type === 'hero')?.subtitle;
const metaDescription = description || branding.description || homeSubtitle;
// Link previews ask for about 1200 px.
const shareSource = image || branding.share_image;
const shareImage = imageUrlAtWidth(shareSource, 1200, imageOptions);
const shareImageSize = findImage(shareSource, imageOptions)?.variants.find((variant) => shareImage?.endsWith(variant.path));

// The same page in the atlas's other languages, for search engines.
const atlasLocales = getAtlasLocales();
const pathAfterLocale = Astro.url.pathname.replace(/^\/[a-z]{2}(?=\/|$)/, '');
const alternates = atlasLocales.length > 1
  ? [...atlasLocales.map((locale) => ({ hreflang: locale, locale })), { hreflang: 'x-default', locale: getAtlasDefaultLocale() }]
    .map(({ hreflang, locale }) => ({ hreflang, href: `${publicOrigin(Astro.request)}/${locale}${pathAfterLocale || '/'}` }))
  : [];

---

<!DOCTYPE html>
<html
  lang={lang}
>
  <head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <link rel='icon' href={favicon} />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link rel='stylesheet' href={fontsHref(fontHeader, fontBody)} />
    <title>{ serverTitle }</title>
    { metaDescription && <meta name='description' content={metaDescription} /> }
    <meta property='og:title' content={documentTitle} />
    { metaDescription && <meta property='og:description' content={metaDescription} /> }
    { shareImage && <meta property='og:image' content={shareImage} /> }
    { shareImageSize && <meta property='og:image:width' content={String(shareImageSize.width)} /> }
    { shareImageSize && <meta property='og:image:height' content={String(shareImageSize.height)} /> }
    <meta name='twitter:card' content={shareImage ? 'summary_large_image' : 'summary'} />
    { alternates.map((alternate) => <link rel='alternate' hreflang={alternate.hreflang} href={alternate.href} />) }
    <style
      is:global
      define:vars={{
        customFontHeader: fontFamily(fontHeader),
        customFontBody: fontFamily(fontBody),
        customHeroHeaderSize: heroHeaderSize,
        customBannerHeaderVariant: bannerHeaderVariant,
        customBannerHeaderTransform: bannerHeaderTransform,
        customPageHeaderSize: pageHeaderSize,
        customHeaderFontWeight: headerFontWeight,
        customLayout: colorLayout,
        customLayoutAlternate: colorLayoutAlternate,
        customColorPrimary: colorPrimary,
        customColorSecondary: colorSecondary,
        customColorTertiary: colorTertiary,
        customPrimaryContent: primaryContent,
        customSecondaryContent: secondaryContent,
        customTertiaryContent: tertiaryContent,
        customContent: layoutContent,
        customContentAlternate: layoutContentAlternate,
        customAlternateContent: layoutAlternateContent,
        customAlternateContentAlternate: layoutAlternateContentAlternate,
        customText: content,
        customTextInverse: contentInverse
      }}
    >
    </style>
  </head>
  <body
    class='flex h-full sm:min-h-screen flex-col bg-layout text-neutral-dark mx-auto font-sans'
    transition:animate='initial'
  >
    <Title
      defaultTitle={serverTitle}
      titleKey={titleKey}
      client:load
    />
    { isAtlasPreview() && (
      <p
        class='fixed bottom-3 left-3 z-[2000] m-0 max-w-[calc(100vw-1.5rem)] rounded-full border border-amber-400 bg-amber-100 px-4 py-1.5 text-xs font-semibold text-amber-950 shadow'
        role='status'
      >
        Preview: this atlas isn’t published yet. Only people with the preview link can see it.
      </p>
    )}
    <HeaderContainer
      client:load
    >
      <Header
        fullscreen={fullscreen}
        image={logo}
        imageAlt={branding.title}
        title={header?.hide_title ? undefined : branding.title}
        transparent={transparent}
        server:defer
      />
    </HeaderContainer>
    <NotificationPanel
      client:only='react'
    />
    <main
      class='w-full relative flex flex-col grow'
    >
      <slot />
    </main>
    { includeFooter && (
      <Footer
        accessibilityUrl={localizeHref(footer?.accessibility_url, getAtlasDefaultLocale(), lang)}
        copyright={footer?.copyright}
        credit={footer?.credit}
        custom={footer?.custom}
        customContent={footer?.custom_content}
        login={footer?.allow_login && !STATIC_BUILD}
        logos={footer?.logos}
        privacyUrl={localizeHref(footer?.privacy_url, getAtlasDefaultLocale(), lang)}
        termsUrl={localizeHref(footer?.terms_url, getAtlasDefaultLocale(), lang)}
        title={branding?.title}
        server:defer
      />
    )}
  </body>
</html>
