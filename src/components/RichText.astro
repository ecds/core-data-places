---
import { getAssetBase } from '@atlas/server';
import { sanitizeHtml } from '@utils/html';

// Longform rich text. TinaCMS (its <TinaMarkdown> renderer) was removed in
// migration step 3; longform arrives as HTML. This renders an HTML string,
// sanitized (it is tenant-controlled), and nothing for the legacy Tina
// rich-text block shape — keeping the page-builder components (Banner /
// FreeText / ColumnContent) that use it building.
const { content } = Astro.props;

const html = typeof content === 'string' ? sanitizeHtml(content, { assetBase: getAssetBase() }) : null;
---
{ html && (
  <div
    class='rich-text max-w-none'
    set:html={html}
  />
) }
